# ───────────────────────────────────────────────
# Launchpad Mission Control – Environment Template
# ───────────────────────────────────────────────
# REQUIRED vars are marked; everything else is optional.
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ── Database ──
# REQUIRED: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ── Authentication ──
# REQUIRED: Strong random secret for JWT signing (32+ characters recommended)
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars-long"

# ── OpenAI (AI Email Generation) ──
# REQUIRED if using AI email features
OPENAI_API_KEY="sk-..."

# ── Resend (Email Sending) ──
# REQUIRED if sending email. Get your API key at https://resend.com
RESEND_API_KEY="re_..."

# ── Email Sender ──
# The "from" address — must be verified in Resend
EMAIL_SENDER="noreply@launchpadcontrol.com"

# ── Backend API ──
# Public-facing URL of the Express backend (used by client-side code)
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000/api"

# ── Express Backend (src/) ──
PORT=5000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
