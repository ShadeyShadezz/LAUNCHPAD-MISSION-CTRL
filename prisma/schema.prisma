generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String    @id @default(uuid())
  name            String    @unique
  logoUrl         String?
  industry        String?
  partnershipDate DateTime?
  status          String
  description     String?
  website         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EmailLog {
  id      String   @id @default(uuid())
  userId  String
  to      String
  subject String
  sentAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String?
  googleId      String?
  fullName      String
  role          Role          @default(STAFF_USER)
  accessLevel   String?
  createdAt     DateTime      @default(now())
  lastLogin     DateTime?
  activityLogs  ActivityLog[]
  emailDrafts   EmailDraft[]
  emailLogs     EmailLog[]
  interactions  Interaction[]
  partners      Partner[]     @relation("CreatedBy")
  savedSearches SavedSearch[]
  staffNotes    StaffNote[]
  students      Student[]     @relation("AddedBy")
}

model Student {
  id                   String        @id @default(uuid())
  fullName             String
  email                String?
  partnerId            String
  status               StudentStatus @default(PENDING)
  cohort               String?
  earlyReleaseEligible Boolean       @default(false)
  addedById            String
  addedDate            DateTime      @default(now())
  notes                String?
  addedByUser          User          @relation("AddedBy", fields: [addedById], references: [id])
  partner              Partner       @relation(fields: [partnerId], references: [id])
  interactions         Interaction[] @relation("InteractionStudents")
}

model Partner {
  id                       String        @id @default(uuid())
  organizationName         String
  logoUrl                  String?
  industry                 String?
  description              String?
  websiteUrl               String?
  schoolType               String?
  officialStatusDate       DateTime?
  courseNumber             Int?
  makeVirtualHours         Int?
  totalPaidContentSees     Int?
  partnerType              String?
  partnerStatus            String?
  currentStatusNotes       String?
  earlyReleaseForSeniors   Boolean       @default(false)
  pastCohortMembers        Json?
  originalJobNoticeDetails String?
  tags                     String[]
  createdById              String
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  contacts                 Contact[]
  emailDrafts              EmailDraft[]
  interactions             Interaction[]
  createdBy                User          @relation("CreatedBy", fields: [createdById], references: [id])
  students                 Student[]

  @@index([createdById])
}

model Contact {
  id          String      @id @default(uuid())
  partnerId   String
  contactType ContactType
  name        String
  email       String
  title       String?
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model Interaction {
  id              String          @id @default(uuid())
  partnerId       String
  interactionType InteractionType
  staffId         String
  date            DateTime
  studentCount    Int             @default(0)
  sharedNotes     String?
  needsFollowup   Boolean         @default(false)
  followupDueDate DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  partner         Partner         @relation(fields: [partnerId], references: [id])
  staff           User            @relation(fields: [staffId], references: [id])
  students        Student[]       @relation("InteractionStudents")

  @@index([partnerId])
  @@index([staffId])
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String
  action         String
  targetType     String
  targetId       String?
  targetName     String?
  additionalInfo String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailDraft {
  id           String    @id @default(uuid())
  staffId      String
  partnerId    String
  contactEmail String
  subject      String
  body         String
  aiPromptUsed String?
  isSent       Boolean   @default(false)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  partner      Partner   @relation(fields: [partnerId], references: [id])
  staff        User      @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([partnerId])
}

model SavedSearch {
  id         String   @id @default(uuid())
  userId     String
  name       String
  searchType String
  filters    Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model StaffNote {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

enum Role {
  ADMINISTRATOR
  PROGRAM_COORDINATOR
  PARTNERSHIP_MANAGER
  STAFF_USER
}

enum ContactType {
  LEADERSHIP
  PRIMARY
  SECONDARY
}

enum InteractionType {
  INFOSESSION
  TABLING
  MEETING
  OUTREACH
  INTERVIEWS
  STUDENT_APPLICATION
}

enum StudentStatus {
  ACTIVE_MEMBER
  APPLICANT
  ALUMNI
  PENDING
}
